# --- Database ---------------------------------------------------------------
# Aiven for PostgreSQL: copy the Service URI from the Aiven console.
# Download the CA certificate from the service overview page and point DATABASE_CA_CERT at it.
# DATABASE_URL=postgres://avnadmin:PASSWORD@my-service-project.aivencloud.com:12345/defaultdb?sslmode=require
# DATABASE_CA_CERT=./certs/aiven-ca.pem
DATABASE_URL=postgres://market:market@localhost:5544/market
DATABASE_POOL_MAX=5

# --- Server -----------------------------------------------------------------
PORT=3000
# Public base URL (used for OAuth metadata, upload links, image URLs). Use your tunnel URL when testing with ChatGPT.
PUBLIC_BASE_URL=http://localhost:3000
# Secret used to sign image/upload URLs and hash tokens.
APP_SECRET=change-me-to-a-long-random-string

# --- Auth -------------------------------------------------------------------
# Optional static bearer tokens for local testing (MCP Inspector), format: token:email,token2:email2
DEV_AUTH_TOKENS=dev-seller:seller@example.com,dev-buyer:buyer@example.com

# --- AI providers -----------------------------------------------------------
# openai | fake (deterministic, offline; used by tests)
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Geocoding --------------------------------------------------------------
# nominatim | fake
GEOCODER=nominatim
GEOCODER_USER_AGENT=market-place-dev (contact: you@example.com)

# --- Storage ----------------------------------------------------------------
STORAGE_DIR=./data/blobs

# --- Email ------------------------------------------------------------------
# console | resend
MAILER=console
RESEND_API_KEY=
MAIL_FROM=Marketplace <no-reply@example.com>

# --- Jobs -------------------------------------------------------------------
# queue (pg-boss, needs `pnpm worker`) | inline (run handlers synchronously; tests/dev)
JOBS_MODE=inline
