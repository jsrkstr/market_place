{
  "name": "market-place",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-native secondhand marketplace exposed over MCP (ChatGPT first).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:up": "docker compose up -d db",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "tsx scripts/db-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "nanoid": "^6.0.2",
    "openai": "^7.42.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
